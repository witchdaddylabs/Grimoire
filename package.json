{
  "name": "grimoire",
  "private": true,
  "version": "1.0.0",
  "description": "A local-first writing studio for macOS and Windows, with Grimoire Vault memory and optional AI assistance.",
  "author": "Witch Daddy Labs",
  "license": "MIT",
  "homepage": "https://github.com/witchdaddylabs/grimoire",
  "repository": {
    "type": "git",
    "url": "https://github.com/witchdaddylabs/grimoire.git"
  },
  "bugs": {
    "url": "https://github.com/witchdaddylabs/grimoire/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "check:rust": "cd src-tauri && cargo check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test",
    "verify": "npm run build && npm run test:rust && npm run check:rust",
    "package:mac": "tauri build --bundles dmg",
    "package:win": "tauri build --bundles nsis",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
